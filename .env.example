# Copy this file to .env and paste each key after its equals sign. Never commit .env.
# docs/keys.md has the steps for making both keys and the limits to set on them.

# Required. A Claude API key that belongs to one workspace with a spend limit.
ANTHROPIC_API_KEY=

# Optional. A Google Cloud API key, used by anything that runs on Gemini.
GOOGLE_API_KEY=
